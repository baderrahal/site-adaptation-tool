<Project Sdk="Microsoft.NET.Sdk">
  <!-- R346. The logic of the add-in and the worker, one netstandard2.0 library: it loads in the net48 process of Revit 2024 and in the
       net8.0 tests of the Linux runner. Built against the Newtonsoft.Json 13.0.1 Revit 2024 ships, so the tests run the code Revit runs -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <!-- R342, Q079. The SDK gives netstandard2.0 the NETStandard.Library 2.0.3 package, which asks for Microsoft.NETCore.Platforms 1.1.0
         under the Microsoft .NET Library licence. That package holds only the runtime graph of the restore and copies no file, the
         first MIT version replaces it here, build only, so no package of another licence is restored -->
    <PackageReference Include="Microsoft.NETCore.Platforms" Version="3.1.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- R347. The tests reach the hook of WorkerLaunch that handles the end of a worker late, so the time limit can fire after it exited -->
    <InternalsVisibleTo Include="SiteAdaptation.Tests" />
  </ItemGroup>
</Project>
