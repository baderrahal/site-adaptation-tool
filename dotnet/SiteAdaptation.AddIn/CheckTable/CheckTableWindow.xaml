<Window x:Class="SiteAdaptation.AddIn.CheckTable.CheckTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:th="clr-namespace:SiteAdaptation.AddIn.Theme"
        xmlns:chk="clr-namespace:SiteAdaptation.AddIn.CheckTable"
        xmlns:cc="clr-namespace:SiteAdaptation.Common.CheckTable;assembly=SiteAdaptation.Common"
        Title="{Binding Title}" Width="{DynamicResource SA.Size.DialogWidth}" MaxHeight="{DynamicResource SA.Size.DialogMaxHeight}"
        SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SA.Surface}">
  <!-- R376, docs/design/12-ui-spec.md 7.4 and the New windows of 28 Oct 2026. Every colour, size and font by Theme.xaml, every text in
       docs/design/14-ui-labels.md under Check table -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SiteAdaptation.AddIn;component/Theme/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Shown" />

      <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Body}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Cell}" />
      </Style>
      <Style x:Key="HeadText" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Label}">
        <Setter Property="Foreground" Value="{StaticResource SA.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <!-- R495. A header that sorts its column on a click, with the arrow of Marks beside it -->
      <Style x:Key="HeadSort" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <TextBlock Style="{StaticResource HeadText}" Text="{TemplateBinding Content}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SortArrow" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource SA.TextMuted}" />
        <Setter Property="Width" Value="{StaticResource SA.Size.SortArrowWidth}" />
        <Setter Property="Height" Value="{StaticResource SA.Size.SortArrowHeight}" />
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Left8}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <Trigger Property="Tag" Value="{x:Static cc:CheckSort.Up}">
            <Setter Property="Data" Value="{StaticResource SA.Mark.SortUp}" />
            <Setter Property="Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="Tag" Value="{x:Static cc:CheckSort.Down}">
            <Setter Property="Data" Value="{StaticResource SA.Mark.SortDown}" />
            <Setter Property="Visibility" Value="Visible" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SideValue" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Body}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Row}" />
      </Style>
      <Style x:Key="SideLabel" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Body}">
        <Setter Property="Foreground" Value="{StaticResource SA.TextMuted}" />
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Row}" />
      </Style>

      <!-- A chip: the active one filled SA.Band, Assumed with a dashed amber border -->
      <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="{StaticResource SA.Pad.Chip}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource SA.Radius.Chip}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ChipItem" DataType="{x:Type chk:CheckChipViewModel}">
        <Grid Margin="{StaticResource SA.Gap.Right8}">
          <Button Content="{Binding Text}" Click="OnChip">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SA.Band}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SA.Band}" />
                    <Setter Property="Foreground" Value="{StaticResource SA.Surface}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Rectangle IsHitTestVisible="False" Stroke="{StaticResource SA.Warn}" StrokeDashArray="{StaticResource SA.Dash.Assumed}" RadiusX="{StaticResource SA.Size.ChipRadius}" RadiusY="{StaticResource SA.Size.ChipRadius}"
                     Visibility="{Binding IsAssumed, Converter={StaticResource Shown}}" />
        </Grid>
      </DataTemplate>

      <Style x:Key="RowBox" TargetType="ListBoxItem">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Box" MinHeight="{StaticResource SA.Size.Row}" Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.Border}"
                      BorderThickness="{StaticResource SA.Line.Under}" Background="{StaticResource SA.Surface}">
                <Grid>
                  <Border x:Name="Mark" HorizontalAlignment="Left" Width="{StaticResource SA.Size.SelectedMark}" Background="{StaticResource SA.Accent}" Visibility="Collapsed" Margin="{StaticResource SA.Margin.SelectedMark}" />
                  <ContentPresenter VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="{StaticResource SA.Selected}" />
                  <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="UseItem" TargetType="ComboBoxItem">
        <Setter Property="IsEnabled" Value="{Binding Enabled}" />
        <Setter Property="ToolTip" Value="{Binding Tip}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Padding" Value="{StaticResource SA.Pad.Input}" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource SA.Wait}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="CheckRow" DataType="{x:Type chk:CheckRowViewModel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckPlot}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckNbh}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckUnit}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckType}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckTool}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckRule}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckManual}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckUse}" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RowText}" Text="{Binding Plot}" />
          <TextBlock Grid.Column="1" Style="{StaticResource RowText}" Text="{Binding Nbh}" />
          <TextBlock Grid.Column="2" Style="{StaticResource RowText}" Text="{Binding Unit}" />
          <TextBlock Grid.Column="3" Style="{StaticResource RowText}" Text="{Binding Check}" />
          <TextBlock Grid.Column="4" Style="{StaticResource RowText}" Text="{Binding ToolText}" ToolTip="{Binding ToolText}" />
          <TextBlock Grid.Column="5" Style="{StaticResource RowText}" Text="{Binding PastText}" ToolTip="{Binding PastText}" />
          <TextBlock Grid.Column="6" Style="{StaticResource RowText}" Text="{Binding RuleText}" ToolTip="{Binding RuleTip}" />
          <TextBlock Grid.Column="7" Style="{StaticResource RowText}" Text="{Binding ManualRule}" ToolTip="{Binding ManualRuleTip}" />
          <ComboBox Grid.Column="8" Style="{StaticResource SA.Pane.Combo}" ItemsSource="{Binding UseOptions}" DisplayMemberPath="Name" SelectedValuePath="Name"
                    SelectedValue="{Binding Use, Mode=TwoWay}" ItemContainerStyle="{StaticResource UseItem}" />
        </Grid>
      </DataTemplate>

      <Style x:Key="ChooseButton" TargetType="Button" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Top4}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Background="{StaticResource SA.Surface}">
    <Border DockPanel.Dock="Top" Background="{StaticResource SA.Band}" Padding="{StaticResource SA.Pad.Box}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource SA.Type.Title}" Foreground="{StaticResource SA.Surface}" Text="{Binding Title}" />
          <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.BandText}" Margin="{StaticResource SA.Gap.Top4}" TextTrimming="CharacterEllipsis"
                     Text="{Binding ProfileLine}" Visibility="{Binding ProfileShown, Converter={StaticResource Shown}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource SA.Gap.Left16}">
          <!-- R444. A button with nothing to do is hidden, never shown grey -->
          <Button Style="{StaticResource SA.Button.Base}" Margin="{StaticResource SA.Gap.Right8}" Content="{x:Static chk:CheckTableText.ZoomToPlot}" Click="OnZoom"
                  Visibility="{Binding ZoomAllowed, Converter={StaticResource Shown}}" />
          <Button Style="{StaticResource SA.Button.Base}" Margin="{StaticResource SA.Gap.Right8}" Content="{x:Static chk:CheckTableText.ExportToExcel}" Click="OnExport"
                  Visibility="{Binding ExportAllowed, Converter={StaticResource Shown}}" />
          <Button Style="{StaticResource SA.Button.Primary}" Content="{x:Static chk:CheckTableText.SaveOverrides}" Click="OnSave"
                  IsEnabled="{Binding SaveAllowed}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource SA.Guide}" BorderBrush="{StaticResource SA.GuideBorder}" BorderThickness="{StaticResource SA.Line.Under}"
            Padding="{StaticResource SA.Pad.Box}">
      <TextBlock Style="{StaticResource SA.Pane.Help}" Foreground="{StaticResource SA.Text}" Margin="0" Text="{x:Static chk:CheckTableText.HowTo}" />
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource SA.WarnGround}" Padding="{StaticResource SA.Pad.Box}" Visibility="{Binding NoPastJobShown, Converter={StaticResource Shown}}">
      <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.Warn}" TextWrapping="Wrap" Text="{Binding NoPastJobLine}" />
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource SA.InfoGround}" Padding="{StaticResource SA.Pad.Box}" Visibility="{Binding MessageShown, Converter={StaticResource Shown}}">
      <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.Info}" TextWrapping="Wrap" Text="{Binding Message}" />
    </Border>

    <!-- The side box, 340 wide, on SA.Panel -->
    <Border DockPanel.Dock="Right" Width="{StaticResource SA.Size.SideBox}" Background="{StaticResource SA.Panel}" Padding="{StaticResource SA.Pad.Box}">
      <StackPanel>
        <TextBlock Style="{StaticResource SA.Pane.Section}" Text="{x:Static chk:CheckTableText.Selected}" />
        <TextBlock Style="{StaticResource SA.Pane.Help}" Text="{Binding PickText}" Visibility="{Binding NoneSelected, Converter={StaticResource Shown}}" />
        <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource Shown}}">
          <TextBlock Style="{StaticResource SA.Type.Next}" Margin="{StaticResource SA.Gap.Top4}" TextWrapping="Wrap" Text="{Binding SelectedLine}" />

          <TextBlock Style="{StaticResource SA.Pane.Section}" Margin="{StaticResource SA.Gap.Top16}" Text="{x:Static chk:CheckTableText.Tool}" />
          <TextBlock Style="{StaticResource SideValue}" Text="{Binding SideTool}" />
          <TextBlock Style="{StaticResource SA.Pane.Section}" Margin="{StaticResource SA.Gap.Top16}" Text="{x:Static chk:CheckTableText.PastJob}" />
          <TextBlock Style="{StaticResource SideValue}" Text="{Binding SidePast}" />
          <StackPanel Visibility="{Binding SideWhyShown, Converter={StaticResource Shown}}">
            <TextBlock Style="{StaticResource SA.Pane.Section}" Margin="{StaticResource SA.Gap.Top16}" Text="{x:Static chk:CheckTableText.Why}" />
            <TextBlock Style="{StaticResource SideValue}" Text="{Binding SideWhy}" />
          </StackPanel>

          <StackPanel Visibility="{Binding ManualRuleShown, Converter={StaticResource Shown}}">
            <TextBlock Style="{StaticResource SA.Pane.Section}" Margin="{StaticResource SA.Gap.Top16}" Text="{x:Static chk:CheckTableText.ManualRule}" />
            <TextBlock Style="{StaticResource SideValue}" Text="{Binding ManualRuleLine}" />
            <Button Style="{StaticResource ChooseButton}" Content="{x:Static chk:CheckTableText.OpenRules}" Click="OnOpenRule" />
          </StackPanel>

          <TextBlock Style="{StaticResource SA.Pane.Section}" Margin="{StaticResource SA.Gap.Top16}" Text="{x:Static chk:CheckTableText.Choose}" />
          <Button Style="{StaticResource ChooseButton}" Content="{x:Static chk:CheckTableText.Rule}" Click="OnChooseRule" />
          <TextBlock Style="{StaticResource SA.Pane.Help}" Text="{x:Static chk:CheckTableText.KeepTool}" />
          <TextBlock Style="{StaticResource SA.Pane.Detail}" Text="{Binding GiveRule}" />
          <Button Style="{StaticResource ChooseButton}" Content="{x:Static chk:CheckTableText.Past}" Click="OnChoosePast" IsEnabled="{Binding PastChoosable}"
                  ToolTip="{Binding PastGreyTip}" ToolTipService.ShowOnDisabled="True" />
          <TextBlock Style="{StaticResource SA.Pane.Help}" Text="{x:Static chk:CheckTableText.UsePast}" />
          <TextBlock Style="{StaticResource SA.Pane.Detail}" Text="{Binding GivePast}" />
          <Button Style="{StaticResource ChooseButton}" Content="{x:Static chk:CheckTableText.Skip}" Click="OnChooseSkip" />
          <TextBlock Style="{StaticResource SA.Pane.Help}" Text="{x:Static chk:CheckTableText.LeaveOut}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Margin="{StaticResource SA.Pad.Side}">
      <!-- R443. Door level from, above the chips and the table, the civil file grey with one help line when the setup holds none -->
      <StackPanel Margin="{StaticResource SA.Gap.Bottom16}" Visibility="{Binding DoorShown, Converter={StaticResource Shown}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource HeadText}" Margin="{StaticResource SA.Gap.Right8}" Text="{Binding DoorLabel}" />
          <ComboBox Style="{StaticResource SA.Pane.Combo}" Width="{StaticResource SA.Size.SideBox}" ItemsSource="{Binding DoorOptions}" DisplayMemberPath="Text"
                    SelectedValuePath="Source" SelectedValue="{Binding DoorSource, Mode=TwoWay}" ItemContainerStyle="{StaticResource UseItem}" />
        </StackPanel>
        <TextBlock Style="{StaticResource SA.Pane.Help}" Text="{Binding DoorHelp}" Visibility="{Binding DoorHelpShown, Converter={StaticResource Shown}}" />
      </StackPanel>
      <!-- R495. The rows of one field, and the rows whose plot or note holds the text -->
      <StackPanel Orientation="Horizontal" Margin="{StaticResource SA.Gap.Bottom8}">
        <TextBlock Style="{StaticResource HeadText}" Margin="{StaticResource SA.Gap.Right8}" Text="{x:Static chk:CheckTableText.FieldLabel}" />
        <ComboBox Style="{StaticResource SA.Pane.Combo}" Width="{StaticResource SA.Size.FindBox}" ItemsSource="{Binding FieldOptions}" DisplayMemberPath="Text"
                  SelectedValuePath="Field" SelectedValue="{Binding FieldPick, Mode=TwoWay}" />
        <TextBlock Style="{StaticResource HeadText}" Margin="{StaticResource SA.Gap.Left16}" Text="{x:Static chk:CheckTableText.FindLabel}" />
        <TextBox Style="{StaticResource SA.Pane.Entry}" Margin="{StaticResource SA.Gap.Left8}" Width="{StaticResource SA.Size.FindBox}"
                 Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipItem}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource SA.Gap.Left16}">
          <Path Data="{StaticResource SA.Mark.Found}" Stroke="{StaticResource SA.Ok}" StrokeThickness="{StaticResource SA.Size.MarkStroke}" Width="{StaticResource SA.Size.RowMark}"
                Height="{StaticResource SA.Size.RowMark}" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.Ok}" VerticalAlignment="Center" Text="{Binding FollowLine}" />
        </StackPanel>
      </Grid>
      <TextBlock Style="{StaticResource SA.Type.Small}" Foreground="{StaticResource SA.TextMuted}" Margin="{StaticResource SA.Gap.Top8}" Text="{Binding ShowingLine}"
                 Visibility="{Binding ShowingShown, Converter={StaticResource Shown}}" />
      <TextBlock Style="{StaticResource SA.Type.Small}" Foreground="{StaticResource SA.Warn}" Margin="{StaticResource SA.Gap.Top8}" Text="{Binding NotSavedText}"
                 Visibility="{Binding NotSavedShown, Converter={StaticResource Shown}}" />
      <Border Margin="{StaticResource SA.Gap.Top12}" Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.BorderStrong}" BorderThickness="{StaticResource SA.Line.Under}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckPlot}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckNbh}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckUnit}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckType}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckTool}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckRule}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckManual}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.CheckUse}" />
            <ColumnDefinition x:Name="Gutter" Width="0" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Plot}" Click="OnSort" Content="{x:Static chk:CheckTableText.Plot}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[plot]}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Nbh}" Click="OnSort" Content="{x:Static chk:CheckTableText.Nbh}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[nbh]}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Unit}" Click="OnSort" Content="{x:Static chk:CheckTableText.Unit}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[unit]}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Check}" Click="OnSort" Content="{x:Static chk:CheckTableText.Check}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[check]}" />
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Tool}" Click="OnSort" Content="{x:Static chk:CheckTableText.ToolValue}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[tool]}" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Past}" Click="OnSort" Content="{x:Static chk:CheckTableText.PastJob}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[past]}" />
          </StackPanel>
          <StackPanel Grid.Column="6" Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Rule}" Click="OnSort" Content="{x:Static chk:CheckTableText.Rule}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[rule]}" />
          </StackPanel>
          <StackPanel Grid.Column="7" Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Manual}" Click="OnSort" Content="{x:Static chk:CheckTableText.ManualRule}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[manual]}" />
          </StackPanel>
          <StackPanel Grid.Column="8" Orientation="Horizontal">
            <Button Style="{StaticResource HeadSort}" Tag="{x:Static cc:CheckColumn.Use}" Click="OnSort" Content="{x:Static chk:CheckTableText.Use}" />
            <Path Style="{StaticResource SortArrow}" Tag="{Binding Marks[use]}" />
          </StackPanel>
        </Grid>
      </Border>
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemTemplate="{StaticResource CheckRow}" ItemContainerStyle="{StaticResource RowBox}"
               Style="{StaticResource SA.Table.List}" th:TableGutter.Column="{x:Reference Gutter}" MaxHeight="{StaticResource SA.Size.CheckList}"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </StackPanel>
  </DockPanel>
</Window>
