<Window x:Class="SiteAdaptation.AddIn.ScanResults.ScanResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sr="clr-namespace:SiteAdaptation.AddIn.ScanResults"
        xmlns:th="clr-namespace:SiteAdaptation.AddIn.Theme"
        Title="{x:Static sr:ScanResultsText.Title}" Width="{DynamicResource SA.Size.ScanWidth}" MaxHeight="{DynamicResource SA.Size.DialogMaxHeight}"
        SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SA.Surface}">
  <!-- Lane C SCAN-UI, docs/design/boards/ScanResults.dc.html top to bottom. Every colour, size and font by Theme.xaml, every text in
       docs/design/14-ui-labels.md under What the tool read -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SiteAdaptation.AddIn;component/Theme/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Shown" />

      <Style x:Key="HeadText" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Label}">
        <Setter Property="Foreground" Value="{StaticResource SA.Heading}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Body}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Right8}" />
      </Style>
      <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Small}">
        <Setter Property="Foreground" Value="{StaticResource SA.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Right8}" />
      </Style>

      <!-- The chip of a status: green when its Tag is true, amber when false -->
      <Style x:Key="ChipBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SA.OkGround}" />
        <Setter Property="CornerRadius" Value="{StaticResource SA.Radius.Chip}" />
        <Setter Property="Padding" Value="{StaticResource SA.Pad.Chip}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
            <Setter Property="Background" Value="{StaticResource SA.WarnGround}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Small}">
        <Setter Property="FontWeight" Value="{StaticResource SA.Type.Label.Weight}" />
        <Setter Property="Foreground" Value="{StaticResource SA.Ok}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="False">
            <Setter Property="Foreground" Value="{StaticResource SA.Warn}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <DataTemplate x:Key="ValueRow" DataType="{x:Type sr:ScanValueViewModel}">
        <Border Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.Under}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPick}" Value="True">
                  <Setter Property="Background" Value="{StaticResource SA.WarnGround}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SA.Grid.ScanValue}" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="{StaticResource SA.Grid.ScanCovers}" />
              <ColumnDefinition Width="{StaticResource SA.Grid.ScanChecks}" />
              <ColumnDefinition Width="{StaticResource SA.Grid.ScanStatus}" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource HeadText}" Margin="{StaticResource SA.Gap.Right8}" Text="{Binding Label}" />
            <ComboBox Grid.Column="1" Style="{StaticResource SA.Pane.Combo}" Margin="{StaticResource SA.Gap.Right8}" VerticalAlignment="Center"
                      ItemsSource="{Binding Sources}" SelectedItem="{Binding Selected, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Style="{StaticResource CellText}" Text="{Binding Covers}" />
            <TextBlock Grid.Column="3" Style="{StaticResource CellText}" Text="{Binding Checks}" />
            <Border Grid.Column="4" Style="{StaticResource ChipBox}" Tag="{Binding IsClear}">
              <TextBlock Style="{StaticResource ChipText}" Text="{Binding Status}" />
            </Border>
          </Grid>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="FileRow">
        <Border Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.Under}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SA.Grid.ScanFile}" />
              <ColumnDefinition Width="{StaticResource SA.Grid.ScanKind}" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="{StaticResource SA.Grid.ScanStatus}" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CellText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            <TextBlock Grid.Column="1" Style="{StaticResource CellText}" Text="{Binding Kind}" />
            <TextBlock Grid.Column="2" Style="{StaticResource CellText}" Text="{Binding Found}" />
            <Border Grid.Column="3" Style="{StaticResource ChipBox}" Tag="{Binding IsRead}">
              <TextBlock Style="{StaticResource ChipText}" Text="{Binding Status}" />
            </Border>
          </Grid>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="ConflictRow" DataType="{x:Type sr:ScanConflictViewModel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SA.Grid.ScanPlot}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ScanConflictValue}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource CellText}" Text="{Binding Plot}" />
          <TextBlock Grid.Column="1" Style="{StaticResource CellText}" Text="{Binding Value}" />
          <ComboBox Grid.Column="2" Style="{StaticResource SA.Pane.Combo}" VerticalAlignment="Center" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}" />
        </Grid>
      </DataTemplate>

      <Style x:Key="RowBox" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.Under}" Background="{StaticResource SA.Surface}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Background="{StaticResource SA.Surface}">
    <!-- The foot on SA.Panel: the help line, then Cancel, Export to Excel and Use these picks -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SA.Panel}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.Over}" Padding="{StaticResource SA.Pad.Foot}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource HelpText}" VerticalAlignment="Center" Margin="{StaticResource SA.Gap.Right24}" Text="{Binding FootLine}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource SA.Button.Base}" Height="{StaticResource SA.Size.MainButton}" Content="{x:Static sr:ScanResultsText.Cancel}" Click="OnCancel" />
          <Button Style="{StaticResource SA.Button.DryRun}" Height="{StaticResource SA.Size.MainButton}" Margin="{StaticResource SA.Gap.Left8}" Content="{x:Static sr:ScanResultsText.Export}" Click="OnExport" />
          <Button Style="{StaticResource SA.Button.Primary}" Margin="{StaticResource SA.Gap.Left8}" Content="{x:Static sr:ScanResultsText.UsePicks}" Click="OnUse" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource SA.Band}" Padding="{StaticResource SA.Pad.Side}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="{StaticResource SA.Gap.Right24}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource SA.Type.Title}" Foreground="{StaticResource SA.Surface}" VerticalAlignment="Center" Text="{x:Static sr:ScanResultsText.Title}" />
            <Border Margin="{StaticResource SA.Gap.Left8}" Background="{StaticResource SA.BandAccent}" CornerRadius="{StaticResource SA.Radius.Chip}"
                    Padding="{StaticResource SA.Pad.Chip}" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SA.Type.Small}" FontWeight="{StaticResource SA.Type.Label.Weight}" Foreground="{StaticResource SA.Band}" Text="{x:Static sr:ScanResultsText.Badge}" />
            </Border>
          </StackPanel>
          <TextBlock Style="{StaticResource SA.Type.Step}" Foreground="{StaticResource SA.BandText}" Margin="{StaticResource SA.Gap.Top4}" TextWrapping="Wrap"
                     MaxWidth="{StaticResource SA.Size.ScanLine}" Text="{x:Static sr:ScanResultsText.Line}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource SA.Type.Count}" Foreground="{StaticResource SA.Surface}" HorizontalAlignment="Right" Text="{Binding FilesRead}" />
            <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.BandText}" HorizontalAlignment="Right" Text="{x:Static sr:ScanResultsText.FilesRead}" />
          </StackPanel>
          <StackPanel Margin="{StaticResource SA.Gap.Left24}">
            <TextBlock Style="{StaticResource SA.Type.Count}" Foreground="{StaticResource SA.Surface}" HorizontalAlignment="Right" Text="{Binding PlotsFound}" />
            <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.BandText}" HorizontalAlignment="Right" Text="{x:Static sr:ScanResultsText.PlotsFound}" />
          </StackPanel>
          <StackPanel Margin="{StaticResource SA.Gap.Left24}">
            <TextBlock Style="{StaticResource SA.Type.Count}" Foreground="{StaticResource SA.WarnGround}" HorizontalAlignment="Right" Text="{Binding ConflictCount}" />
            <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.BandText}" HorizontalAlignment="Right" Text="{x:Static sr:ScanResultsText.Conflicts}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="{StaticResource SA.Pad.Side}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{StaticResource SA.Grid.ScanSide}" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="{StaticResource SA.Gap.Right24}">
          <TextBlock Style="{StaticResource SA.Type.Section}" Foreground="{StaticResource SA.Heading}" Text="{x:Static sr:ScanResultsText.ValuesTitle}" />
          <TextBlock Style="{StaticResource HelpText}" Margin="{StaticResource SA.Gap.Top4}" Text="{x:Static sr:ScanResultsText.ValuesHelp}" />
          <Border Margin="{StaticResource SA.Gap.Top8}" Background="{StaticResource SA.Panel}" Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.Under}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SA.Grid.ScanValue}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource SA.Grid.ScanCovers}" />
                <ColumnDefinition Width="{StaticResource SA.Grid.ScanChecks}" />
                <ColumnDefinition Width="{StaticResource SA.Grid.ScanStatus}" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnValue}" />
              <TextBlock Grid.Column="1" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnSource}" />
              <TextBlock Grid.Column="2" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnCovers}" />
              <TextBlock Grid.Column="3" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnChecks}" />
              <TextBlock Grid.Column="4" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnStatus}" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource ValueRow}" />

          <TextBlock Style="{StaticResource SA.Type.Section}" Foreground="{StaticResource SA.Heading}" Margin="{StaticResource SA.Gap.Top16}" Text="{x:Static sr:ScanResultsText.FilesTitle}" />
          <TextBlock Style="{StaticResource HelpText}" Margin="{StaticResource SA.Gap.Top4}" Text="{x:Static sr:ScanResultsText.FilesHelp}" />
          <Border Margin="{StaticResource SA.Gap.Top8}" Background="{StaticResource SA.Panel}" Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.Under}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SA.Grid.ScanFile}" />
                <ColumnDefinition Width="{StaticResource SA.Grid.ScanKind}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource SA.Grid.ScanStatus}" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnFile}" />
              <TextBlock Grid.Column="1" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnKind}" />
              <TextBlock Grid.Column="2" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnFound}" />
              <TextBlock Grid.Column="3" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnStatus}" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRow}" />
        </StackPanel>

        <StackPanel Grid.Column="1">
          <!-- One box for each value that is Pick. The box goes when the user picks the source -->
          <ItemsControl ItemsSource="{Binding Unclear}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="{StaticResource SA.Gap.Bottom16}" Background="{StaticResource SA.WarnGround}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.All}"
                        CornerRadius="{StaticResource SA.Radius.Control}" Padding="{StaticResource SA.Pad.Box}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SA.Type.Step}" FontWeight="{StaticResource SA.Type.Label.Weight}" Foreground="{StaticResource SA.Warn}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource SA.Type.Body}" Margin="{StaticResource SA.Gap.Top4}" TextWrapping="Wrap" Text="{Binding Line}" />
                    <TextBlock Style="{StaticResource SA.Type.Body}" Margin="{StaticResource SA.Gap.Top4}" TextWrapping="Wrap" Text="{Binding ToDo}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Visibility="{Binding HasConflicts, Converter={StaticResource Shown}}">
            <TextBlock Style="{StaticResource SA.Type.Section}" Foreground="{StaticResource SA.Heading}" Text="{x:Static sr:ScanResultsText.ConflictsTitle}" />
            <TextBlock Style="{StaticResource HelpText}" Margin="{StaticResource SA.Gap.Top4}" Text="{x:Static sr:ScanResultsText.ConflictsHelp}" />
            <Border Margin="{StaticResource SA.Gap.Top8}" Background="{StaticResource SA.Panel}" Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.Under}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource SA.Grid.ScanPlot}" />
                  <ColumnDefinition Width="{StaticResource SA.Grid.ScanConflictValue}" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition x:Name="Gutter" Width="0" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnPlot}" />
                <TextBlock Grid.Column="1" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnValue}" />
                <TextBlock Grid.Column="2" Style="{StaticResource HeadText}" Text="{x:Static sr:ScanResultsText.ColumnUse}" />
              </Grid>
            </Border>
            <ListBox ItemsSource="{Binding Conflicts}" ItemTemplate="{StaticResource ConflictRow}" ItemContainerStyle="{StaticResource RowBox}"
                     Style="{StaticResource SA.Table.List}" th:TableGutter.Column="{x:Reference Gutter}" MaxHeight="{StaticResource SA.Size.ScanList}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <StackPanel Orientation="Horizontal" Margin="{StaticResource SA.Gap.Top8}">
              <Button Style="{StaticResource SmallButton}" Content="{Binding ShowAllText}" Click="OnShowAll" Visibility="{Binding CanShowAll, Converter={StaticResource Shown}}" />
              <Button Style="{StaticResource SmallButton}" Content="{x:Static sr:ScanResultsText.UseProposed}" Click="OnUseProposed" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
