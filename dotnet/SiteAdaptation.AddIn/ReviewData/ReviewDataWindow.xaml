<Window x:Class="SiteAdaptation.AddIn.ReviewData.ReviewDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rev="clr-namespace:SiteAdaptation.AddIn.ReviewData"
        Title="{Binding Title}" Width="{DynamicResource SA.Size.DialogWidth}" MaxHeight="{DynamicResource SA.Size.DialogMaxHeight}"
        SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SA.Surface}">
  <!-- R406, docs/design/12-ui-spec.md New windows of 28 Oct 2026 top to bottom. Every colour, size and font by Theme.xaml, every text
       in docs/design/14-ui-labels.md under Review data -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SiteAdaptation.AddIn;component/Theme/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Shown" />

      <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Body}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <Style x:Key="HeadText" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Label}">
        <Setter Property="Foreground" Value="{StaticResource SA.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="SideLabel" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Body}">
        <Setter Property="Foreground" Value="{StaticResource SA.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Row}" />
      </Style>
      <Style x:Key="SideValue" TargetType="TextBlock" BasedOn="{StaticResource RowText}">
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Row}" />
      </Style>

      <!-- A chip: the active one filled SA.Band -->
      <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="{StaticResource SA.Pad.Chip}" />
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Right8}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource SA.Radius.Chip}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ChipItem" DataType="{x:Type rev:ChipViewModel}">
        <Button Content="{Binding Text}" Click="OnChip">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource Chip}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                  <Setter Property="Background" Value="{StaticResource SA.Band}" />
                  <Setter Property="BorderBrush" Value="{StaticResource SA.Band}" />
                  <Setter Property="Foreground" Value="{StaticResource SA.Surface}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </DataTemplate>

      <!-- A row of the table. The selected row stands on SA.Selected with the 3 px SA.Accent mark on its left -->
      <Style x:Key="RowBox" TargetType="ListBoxItem">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Box" MinHeight="{StaticResource SA.Size.Row}" Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.Border}"
                      BorderThickness="{StaticResource SA.Line.Under}" Background="{StaticResource SA.Surface}">
                <Grid>
                  <Border x:Name="Mark" HorizontalAlignment="Left" Width="{StaticResource SA.Size.SelectedMark}" Background="{StaticResource SA.Accent}" Visibility="Collapsed" Margin="-8,-4,0,-4" />
                  <ContentPresenter VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="{StaticResource SA.Selected}" />
                  <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="PlotRow" DataType="{x:Type rev:ReviewRowViewModel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewPlot}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewLabel}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewType}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewMirror}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewCluster}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewArea}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewRoad}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RowText}" Text="{Binding PlotNo}" ToolTip="{Binding RuleTip}" />
          <TextBlock Grid.Column="1" Style="{StaticResource RowText}" Text="{Binding CadLabel}" />
          <TextBlock Grid.Column="2" Style="{StaticResource RowText}" Text="{Binding VillaType}" />
          <TextBlock Grid.Column="3" Style="{StaticResource RowText}" Text="{Binding Mirror}" />
          <TextBlock Grid.Column="4" Style="{StaticResource RowText}" Text="{Binding Cluster}" />
          <TextBlock Grid.Column="5" Style="{StaticResource RowText}" Text="{Binding Area}" />
          <TextBlock Grid.Column="6" Style="{StaticResource RowText}" Text="{Binding RoadAtFront}" />
          <Border Grid.Column="7" CornerRadius="{StaticResource SA.Radius.Chip}" Padding="{StaticResource SA.Pad.Chip}" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOk}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SA.OkGround}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsWrong}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SA.ErrorGround}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding Check}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource RowText}">
                  <Setter Property="Foreground" Value="{StaticResource SA.TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource SA.Ok}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsWrong}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource SA.Error}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="CornerRow" DataType="{x:Type rev:CornerViewModel}">
        <Grid Margin="{StaticResource SA.Gap.Row}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewCorner}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RowText}" Text="{Binding Name}" />
          <TextBlock Grid.Column="1" Style="{StaticResource RowText}" Text="{Binding X}" />
          <TextBlock Grid.Column="2" Style="{StaticResource RowText}" Text="{Binding Y}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SA.Pane.Detail}" Text="{Binding Shared}" />
        </Grid>
      </DataTemplate>

      <Style x:Key="MarkButton" TargetType="Button" BasedOn="{StaticResource SA.Button.Base}">
        <Setter Property="Margin" Value="{StaticResource SA.Gap.Right8}" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Background="{StaticResource SA.Surface}">
    <Border DockPanel.Dock="Top" Background="{StaticResource SA.Band}" Padding="{StaticResource SA.Pad.Box}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource SA.Type.Title}" Foreground="{StaticResource SA.Surface}" Text="{Binding Title}" />
          <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.BandText}" Margin="{StaticResource SA.Gap.Top4}" TextTrimming="CharacterEllipsis"
                     Text="{Binding ReadFromLine}" />
          <TextBlock Style="{StaticResource SA.Type.Small}" Foreground="{StaticResource SA.BandAccent}" Margin="{StaticResource SA.Gap.Top4}" Text="{Binding CheckedLine}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource SA.Gap.Left16}">
          <Button Style="{StaticResource SA.Button.Base}" Content="{x:Static rev:ReviewDataText.ZoomToPlot}" Click="OnZoom" />
          <Button Style="{StaticResource SA.Button.Base}" Margin="{StaticResource SA.Gap.Left8}" Content="{x:Static rev:ReviewDataText.ExportToExcel}" Click="OnExport" />
          <Button Style="{StaticResource SA.Button.Primary}" Margin="{StaticResource SA.Gap.Left8}" Content="{x:Static rev:ReviewDataText.SaveReview}" Click="OnSave" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource SA.Guide}" BorderBrush="{StaticResource SA.GuideBorder}" BorderThickness="{StaticResource SA.Line.Under}"
            Padding="{StaticResource SA.Pad.Box}">
      <TextBlock Style="{StaticResource SA.Pane.Help}" Foreground="{StaticResource SA.Text}" Margin="0" Text="{x:Static rev:ReviewDataText.HowTo}" />
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource SA.InfoGround}" Padding="{StaticResource SA.Pad.Box}" Visibility="{Binding MessageShown, Converter={StaticResource Shown}}">
      <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.Info}" TextWrapping="Wrap" Text="{Binding Message}" />
    </Border>

    <!-- The side box, 340 wide, on SA.Panel -->
    <Border DockPanel.Dock="Right" Width="{StaticResource SA.Size.SideBox}" Background="{StaticResource SA.Panel}" Padding="{StaticResource SA.Pad.Box}">
      <StackPanel>
        <TextBlock Style="{StaticResource SA.Pane.Section}" Text="{x:Static rev:ReviewDataText.SelectedPlot}" />
        <TextBlock Style="{StaticResource SA.Pane.Help}" Text="{Binding PickText}" Visibility="{Binding NoneSelected, Converter={StaticResource Shown}}" />
        <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource Shown}}">
          <TextBlock Style="{StaticResource SA.Type.Next}" Margin="{StaticResource SA.Gap.Top4}" Text="{Binding SelectedPlot}" />
          <TextBlock Style="{StaticResource SA.Pane.Help}" Text="{Binding ManualRuleLine}" />
          <Grid Margin="{StaticResource SA.Gap.Top8}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SA.Grid.ReviewSideLabel}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SideLabel}" Text="{x:Static rev:ReviewDataText.CadLabel}" />
            <TextBlock Grid.Column="1" Style="{StaticResource SideValue}" Text="{Binding SideCadLabel}" />
            <TextBlock Grid.Row="1" Style="{StaticResource SideLabel}" Text="{x:Static rev:ReviewDataText.Nbh}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SideValue}" Text="{Binding SideNbh}" />
            <TextBlock Grid.Row="2" Style="{StaticResource SideLabel}" Text="{x:Static rev:ReviewDataText.Cluster}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SideValue}" Text="{Binding SideCluster}" />
            <TextBlock Grid.Row="3" Style="{StaticResource SideLabel}" Text="{x:Static rev:ReviewDataText.Mirror}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SideValue}" Text="{Binding SideMirror}" />
            <TextBlock Grid.Row="4" Style="{StaticResource SideLabel}" Text="{x:Static rev:ReviewDataText.FrontEdge}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SideValue}" Text="{Binding SideFrontEdge}" />
            <TextBlock Grid.Row="5" Style="{StaticResource SideLabel}" Text="{x:Static rev:ReviewDataText.RoadAtFront}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource SideValue}" Text="{Binding SideRoad}" />
          </Grid>

          <TextBlock Style="{StaticResource SA.Pane.Section}" Margin="{StaticResource SA.Gap.Top16}" Text="{x:Static rev:ReviewDataText.PlotCorners}" />
          <Grid Margin="{StaticResource SA.Gap.Top8}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SA.Grid.ReviewCorner}" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.X}" />
            <TextBlock Grid.Column="2" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.Y}" />
          </Grid>
          <TextBlock Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.SharedCoordinates}" />
          <ItemsControl ItemsSource="{Binding Corners}" ItemTemplate="{StaticResource CornerRow}" />

          <TextBlock Style="{StaticResource SA.Pane.Section}" Margin="{StaticResource SA.Gap.Top16}" Text="{x:Static rev:ReviewDataText.TeamCheck}" />
          <StackPanel Orientation="Horizontal" Margin="{StaticResource SA.Gap.Top8}">
            <Button Style="{StaticResource MarkButton}" Content="{x:Static rev:ReviewDataText.Ok}" Click="OnOk" />
            <Button Style="{StaticResource MarkButton}" Content="{x:Static rev:ReviewDataText.Wrong}" Click="OnWrong" />
          </StackPanel>
          <TextBlock Style="{StaticResource SA.Pane.Help}" Margin="{StaticResource SA.Gap.Top8}" Text="{x:Static rev:ReviewDataText.WhatIsWrong}" />
          <TextBox Style="{StaticResource SA.Pane.Entry}" Margin="{StaticResource SA.Gap.Top4}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource SA.Pane.Help}" Text="{Binding EarlierNoteLine}" Visibility="{Binding EarlierNoteShown, Converter={StaticResource Shown}}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Margin="{StaticResource SA.Pad.Side}">
      <StackPanel Orientation="Horizontal">
        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipItem}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Style="{StaticResource SideLabel}" Margin="{StaticResource SA.Gap.Left16}" Text="{x:Static rev:ReviewDataText.FindPlot}" />
        <TextBox Style="{StaticResource SA.Pane.Entry}" Margin="{StaticResource SA.Gap.Left8}" Width="{StaticResource SA.Size.FindBox}"
                 Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource SA.Type.Small}" Foreground="{StaticResource SA.Warn}" Margin="{StaticResource SA.Gap.Left16}" VerticalAlignment="Center"
                   Text="{Binding NotSavedText}" Visibility="{Binding NotSavedShown, Converter={StaticResource Shown}}" />
      </StackPanel>
      <Border Margin="{StaticResource SA.Gap.Top12}" Padding="{StaticResource SA.Pad.Cell}" BorderBrush="{StaticResource SA.BorderStrong}" BorderThickness="{StaticResource SA.Line.Under}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewPlot}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewLabel}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewType}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewMirror}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewCluster}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewArea}" />
            <ColumnDefinition Width="{StaticResource SA.Grid.ReviewRoad}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.PlotNo}" />
          <TextBlock Grid.Column="1" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.CadLabel}" />
          <TextBlock Grid.Column="2" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.VillaType}" />
          <TextBlock Grid.Column="3" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.Mirror}" />
          <TextBlock Grid.Column="4" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.Cluster}" />
          <TextBlock Grid.Column="5" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.AreaM2}" />
          <TextBlock Grid.Column="6" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.RoadAtFront}" />
          <TextBlock Grid.Column="7" Style="{StaticResource HeadText}" Text="{x:Static rev:ReviewDataText.TeamCheck}" />
        </Grid>
      </Border>
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemTemplate="{StaticResource PlotRow}" ItemContainerStyle="{StaticResource RowBox}"
               BorderThickness="0" Background="{StaticResource SA.Surface}" HorizontalContentAlignment="Stretch" MaxHeight="{StaticResource SA.Size.ReviewList}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </StackPanel>
  </DockPanel>
</Window>
