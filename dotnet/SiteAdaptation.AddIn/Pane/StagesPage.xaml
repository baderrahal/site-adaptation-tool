<Page x:Class="SiteAdaptation.AddIn.Pane.StagesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pane="clr-namespace:SiteAdaptation.AddIn.Pane"
      xmlns:scan="clr-namespace:SiteAdaptation.AddIn.ScanResults"
      xmlns:help="clr-namespace:SiteAdaptation.AddIn.Help"
      xmlns:rw="clr-namespace:SiteAdaptation.AddIn.RulesWindow">
  <!-- R680. The pane in 3 stages, Bader's order of 6 Nov 2026: three cards each with a status, an i icon and one main button, Settings and Advanced.
       Every colour, size and font by StaticResource of Theme.xaml, every text in docs/design/14-ui-labels.md -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SiteAdaptation.AddIn;component/Theme/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="Shown" />

      <!-- The line of a card, folded while it says nothing so no empty gap stands under the status -->
      <Style x:Key="CardLine" TargetType="TextBlock" BasedOn="{StaticResource SA.Pane.Help}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- The head of a card: title, i icon, status -->
      <DataTemplate x:Key="CardHead" DataType="{x:Type pane:StageCard}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SA.Pane.Section}" Text="{Binding Title}" />
            <Button Grid.Column="1" Style="{StaticResource SA.Button.Info}" Content="{x:Static help:HelpText.Mark}" ToolTip="{Binding Help}" />
          </Grid>
          <TextBlock TextWrapping="Wrap" Text="{Binding Status}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SA.Pane.Help}">
                <Setter Property="Foreground" Value="{StaticResource SA.Wait}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Good}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SA.Ok}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </DataTemplate>

      <!-- R681. One row of the data check: the need and its mark, the plain line of the worker under them -->
      <DataTemplate x:Key="CheckRow" DataType="{x:Type scan:DataCheckRow}">
        <Grid Margin="{StaticResource SA.Gap.Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource SA.Type.Body}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
          <!-- The plain line of the need under its name and mark, R681 -->
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SA.Pane.Help}" TextWrapping="Wrap" Text="{Binding Line}" />
          <TextBlock Grid.Column="1" Text="{Binding Mark}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SA.Pane.Chip}">
                <Setter Property="Foreground" Value="{StaticResource SA.Warn}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsGood}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SA.Ok}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Page.Resources>

  <DockPanel Background="{StaticResource SA.Surface}">
    <Border DockPanel.Dock="Top" Background="{StaticResource SA.Band}" Padding="{StaticResource SA.Pad.Box}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.BandAccent}" Text="Project" />
          <TextBlock Style="{StaticResource SA.Type.Project}" Foreground="{StaticResource SA.Surface}" Margin="{StaticResource SA.Gap.Top4}"
                     TextTrimming="CharacterEllipsis" Text="{Binding Model.ProjectName}" ToolTip="{Binding Model.ProjectName}" />
        </StackPanel>
        <!-- The gear: Settings opens the project setup and the rules under the head -->
        <Button Grid.Column="1" Style="{StaticResource SA.Button.Base}" VerticalAlignment="Center" Content="{x:Static pane:StageText.SettingsButton}" Command="{Binding SettingsCommand}" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource SA.Panel}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.Under}"
            Padding="{StaticResource SA.Pad.SectionBox}" Visibility="{Binding SettingsOpen, Converter={StaticResource Shown}}">
      <StackPanel>
        <Grid Height="{StaticResource SA.Size.Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource SA.Type.Body}" VerticalAlignment="Center" Text="{x:Static pane:StageText.ProjectSetup}" />
          <Button Grid.Column="1" Style="{StaticResource SA.Button.Base}" VerticalAlignment="Center" Content="{x:Static pane:StageText.Edit}" Command="{Binding Model.NewProjectCommand}" />
        </Grid>
        <!-- R682. The rules table of this project -->
        <Grid Height="{StaticResource SA.Size.Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource SA.Type.Body}" VerticalAlignment="Center" Text="{x:Static rw:ProjectRulesText.OpenRules}" />
          <Button Grid.Column="1" Style="{StaticResource SA.Button.Base}" VerticalAlignment="Center" Content="{x:Static rw:ProjectRulesText.Open}" Command="{Binding RulesCommand}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- R683. One amber line until the rules of the project are confirmed -->
    <Border x:Name="RulesLineBox" DockPanel.Dock="Top" Background="{StaticResource SA.WarnGround}" BorderBrush="{StaticResource SA.WarnBorder}" BorderThickness="{StaticResource SA.Line.Under}"
            Padding="{StaticResource SA.Pad.SectionBox}" Visibility="{Binding HasRulesLine, Converter={StaticResource Shown}}">
      <TextBlock Style="{StaticResource SA.Type.Body}" Foreground="{StaticResource SA.Warn}" TextWrapping="Wrap" Text="{Binding RulesLine}" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel IsEnabled="{Binding Model.HasDocument}">
        <!-- Stage 1 Project data -->
        <Border x:Name="Card1Box" Margin="{StaticResource SA.Pad.Section}" Background="{StaticResource SA.Panel}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.All}"
                CornerRadius="{StaticResource SA.Radius.Control}" Padding="{StaticResource SA.Pad.Panel}">
          <StackPanel>
            <ContentControl Content="{Binding Card1}" ContentTemplate="{StaticResource CardHead}" />
            <TextBlock Style="{StaticResource CardLine}" Text="{Binding Card1.Line}" />
            <ItemsControl Margin="{StaticResource SA.Gap.Top8}" ItemsSource="{Binding CheckRows}" ItemTemplate="{StaticResource CheckRow}" />
            <StackPanel Orientation="Horizontal" Margin="{StaticResource SA.Gap.Top8}">
              <Button Style="{StaticResource SA.Button.Primary}" Margin="{StaticResource SA.Gap.Right8}" Content="{Binding Card1.Button}" Command="{Binding Card1.Command}" />
              <Button Style="{StaticResource SA.Button.Base}" Content="{x:Static pane:StageText.FixItems}" Command="{Binding FixItemsCommand}" Visibility="{Binding HasRows, Converter={StaticResource Shown}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Stage 2 Build site -->
        <Border x:Name="Card2Box" Margin="{StaticResource SA.Pad.Section}" Background="{StaticResource SA.Panel}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.All}"
                CornerRadius="{StaticResource SA.Radius.Control}" Padding="{StaticResource SA.Pad.Panel}">
          <StackPanel>
            <ContentControl Content="{Binding Card2}" ContentTemplate="{StaticResource CardHead}" />
            <!-- R686. The scope in the words of the project, the Preview tick and the line of the last press -->
            <TextBlock Style="{StaticResource SA.Type.Body}" TextWrapping="Wrap" Margin="{StaticResource SA.Gap.Top4}" Text="{Binding ScopeLine}" />
            <TextBlock Style="{StaticResource CardLine}" Text="{Binding Card2.Line}" />
            <StackPanel Orientation="Horizontal" Margin="{StaticResource SA.Gap.Top8}">
              <Button Style="{StaticResource SA.Button.Primary}" Margin="{StaticResource SA.Gap.Right8}" Content="{Binding Card2.Button}" Command="{Binding Card2.Command}" />
              <CheckBox x:Name="PreviewTick" Style="{StaticResource SA.Pane.Check}" VerticalAlignment="Center" Content="{x:Static pane:SiteBuildText.Preview}" IsChecked="{Binding PreviewFirst, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Stage 3 Review and deliver -->
        <Border x:Name="Card3Box" Margin="{StaticResource SA.Pad.Section}" Background="{StaticResource SA.Panel}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.All}"
                CornerRadius="{StaticResource SA.Radius.Control}" Padding="{StaticResource SA.Pad.Panel}">
          <StackPanel>
            <ContentControl Content="{Binding Card3}" ContentTemplate="{StaticResource CardHead}" />
            <!-- R689. The issues of the last build, the rules table from a rule issue, and where each value came from -->
            <Grid Margin="{StaticResource SA.Gap.Top4}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource SA.Type.Body}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding IssuesLine}" />
              <Button Grid.Column="1" Style="{StaticResource SA.Button.Base}" Content="{x:Static pane:StageResultsText.OpenRules}" Command="{Binding RulesCommand}"
                      Visibility="{Binding RuleIssue, Converter={StaticResource Shown}}" />
            </Grid>
            <TextBlock Style="{StaticResource CardLine}" Foreground="{StaticResource SA.Warn}" Text="{Binding NoRoadLevelLine}" />
            <StackPanel x:Name="MixBox" Margin="{StaticResource SA.Gap.Top8}" Visibility="{Binding HasMix, Converter={StaticResource Shown}}">
              <Grid Height="{StaticResource SA.Size.StatusMark}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding MixComputed}" />
                  <ColumnDefinition Width="{Binding MixRule}" />
                  <ColumnDefinition Width="{Binding MixPerson}" />
                  <ColumnDefinition Width="{Binding MixMissing}" />
                  <ColumnDefinition Width="{Binding MixOther}" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SA.Ok}" />
                <Border Grid.Column="1" Background="{StaticResource SA.Accent}" />
                <Border Grid.Column="2" Background="{StaticResource SA.Info}" />
                <Border Grid.Column="3" Background="{StaticResource SA.Warn}" />
                <Border Grid.Column="4" Background="{StaticResource SA.Wait}" />
              </Grid>
              <TextBlock Style="{StaticResource SA.Pane.Help}" TextWrapping="Wrap" Margin="{StaticResource SA.Gap.Top4}" Text="{Binding MixLine}" />
            </StackPanel>
            <TextBlock Style="{StaticResource CardLine}" Text="{Binding Card3.Line}" />
            <StackPanel Orientation="Horizontal" Margin="{StaticResource SA.Gap.Top8}">
              <Button Style="{StaticResource SA.Button.Primary}" Margin="{StaticResource SA.Gap.Right8}" Content="{Binding Card3.Button}" Command="{Binding Card3.Command}" />
              <Button Style="{StaticResource SA.Button.Base}" Content="{x:Static pane:StageResultsText.UpdateFromReport}" Command="{Binding UpdateCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Advanced: the pane of version 1 whole, its 9 step rows among it, closed by default -->
        <Expander Margin="{StaticResource SA.Pad.Section}" Header="{x:Static pane:StageText.Advanced}" IsExpanded="False">
          <Frame x:Name="OldPane" NavigationUIVisibility="Hidden" Focusable="False" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Page>
