<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SiteAdaptation.AddIn</AssemblyName>
    <RootNamespace>SiteAdaptation.AddIn</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- The restore of the Linux leg walks the net48 references of the tests too, and a WPF project there needs this to be read -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <!-- PrivateAssets keeps the Revit reference assemblies from flowing into the test project, which loads no Revit type -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="..\SiteAdaptation.Common\SiteAdaptation.Common.csproj" />
    <!-- net48 WPF has no folder dialog, the folder Browse of Road surface and Prototypes takes the one of Windows Forms -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <!-- Libre Franklin under the SIL Open Font License, docs/licences.md. The font is a resource of the DLL, its licence ships beside it -->
  <ItemGroup>
    <Resource Include="Theme\Fonts\LibreFranklin-Variable.ttf" />
    <None Include="Theme\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
