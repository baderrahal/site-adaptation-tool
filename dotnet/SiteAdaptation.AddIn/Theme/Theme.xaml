<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- R371. The one source of every colour, font, size and icon of the add-in, the values of docs/design/12-ui-spec.md.
       No other XAML or C# file of the add-in holds a colour or a font size, a gate test holds that. -->

  <!-- Colours. A colour the spec gives as one value on another keeps its name for the text and takes Ground for the ground. -->
  <SolidColorBrush x:Key="SA.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SA.Panel" Color="#F5F7FA" />
  <SolidColorBrush x:Key="SA.Band" Color="#1B3349" />
  <SolidColorBrush x:Key="SA.BandText" Color="#DCE8F5" />
  <SolidColorBrush x:Key="SA.BandAccent" Color="#9ED9FD" />
  <SolidColorBrush x:Key="SA.Guide" Color="#EAF3FC" />
  <SolidColorBrush x:Key="SA.GuideBorder" Color="#C9DDF3" />
  <SolidColorBrush x:Key="SA.Border" Color="#D5DCE4" />
  <SolidColorBrush x:Key="SA.BorderStrong" Color="#B8C2CD" />
  <SolidColorBrush x:Key="SA.Text" Color="#1B1F24" />
  <SolidColorBrush x:Key="SA.TextMuted" Color="#4A5663" />
  <SolidColorBrush x:Key="SA.Heading" Color="#1B3349" />
  <SolidColorBrush x:Key="SA.Accent" Color="#0052CC" />
  <SolidColorBrush x:Key="SA.Selected" Color="#E3ECF8" />
  <SolidColorBrush x:Key="SA.IconAccent" Color="#00AEE6" />
  <SolidColorBrush x:Key="SA.IconTick" Color="#2F9E2A" />
  <SolidColorBrush x:Key="SA.Ok" Color="#0B6B2E" />
  <SolidColorBrush x:Key="SA.OkGround" Color="#E6F4EA" />
  <SolidColorBrush x:Key="SA.Warn" Color="#7A4B00" />
  <SolidColorBrush x:Key="SA.WarnGround" Color="#FFF4D6" />
  <SolidColorBrush x:Key="SA.Info" Color="#0A3D91" />
  <SolidColorBrush x:Key="SA.InfoGround" Color="#E6EEFB" />
  <SolidColorBrush x:Key="SA.Wait" Color="#4A5663" />
  <SolidColorBrush x:Key="SA.WaitGround" Color="#F0F2F5" />
  <SolidColorBrush x:Key="SA.Error" Color="#B42318" />
  <SolidColorBrush x:Key="SA.ErrorGround" Color="#FDECEA" />

  <!-- Font. The bundled Libre Franklin first, then the fallbacks of the spec. The file is the variable font, WPF takes its named
       instances Regular and SemiBold as faces of their own, measured in 5a. -->
  <FontFamily x:Key="SA.Font">./Fonts/#Libre Franklin, Franklin Gothic Book, Segoe UI</FontFamily>
  <FontNumeralAlignment x:Key="SA.Figures">Tabular</FontNumeralAlignment>

  <!-- Type. Each key has its size and its weight for a control, and a TextBlock style of the same name. -->
  <sys:Double x:Key="SA.Type.Title.Size">20</sys:Double>
  <FontWeight x:Key="SA.Type.Title.Weight">SemiBold</FontWeight>
  <sys:Double x:Key="SA.Type.Next.Size">18</sys:Double>
  <FontWeight x:Key="SA.Type.Next.Weight">SemiBold</FontWeight>
  <sys:Double x:Key="SA.Type.Section.Size">15</sys:Double>
  <FontWeight x:Key="SA.Type.Section.Weight">SemiBold</FontWeight>
  <sys:Double x:Key="SA.Type.Body.Size">13</sys:Double>
  <FontWeight x:Key="SA.Type.Body.Weight">Regular</FontWeight>
  <sys:Double x:Key="SA.Type.Small.Size">12</sys:Double>
  <FontWeight x:Key="SA.Type.Small.Weight">Regular</FontWeight>
  <sys:Double x:Key="SA.Type.Project.Size">16</sys:Double>
  <FontWeight x:Key="SA.Type.Project.Weight">SemiBold</FontWeight>
  <sys:Double x:Key="SA.Type.Step.Size">14</sys:Double>
  <FontWeight x:Key="SA.Type.Step.Weight">Regular</FontWeight>
  <sys:Double x:Key="SA.Type.Count.Size">28</sys:Double>
  <FontWeight x:Key="SA.Type.Count.Weight">SemiBold</FontWeight>
  <sys:Double x:Key="SA.Type.Label.Size">13</sys:Double>
  <FontWeight x:Key="SA.Type.Label.Weight">SemiBold</FontWeight>

  <Style x:Key="SA.Type.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SA.Font}" />
    <Setter Property="Typography.NumeralAlignment" Value="{StaticResource SA.Figures}" />
    <Setter Property="Foreground" Value="{StaticResource SA.Text}" />
  </Style>
  <Style x:Key="SA.Type.Title" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Title.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Title.Weight}" />
  </Style>
  <Style x:Key="SA.Type.Next" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Next.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Next.Weight}" />
  </Style>
  <Style x:Key="SA.Type.Section" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Section.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Section.Weight}" />
  </Style>
  <Style x:Key="SA.Type.Body" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Body.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Body.Weight}" />
  </Style>
  <Style x:Key="SA.Type.Small" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Small.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Small.Weight}" />
  </Style>
  <Style x:Key="SA.Type.Project" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Project.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Project.Weight}" />
  </Style>
  <Style x:Key="SA.Type.Step" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Step.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Step.Weight}" />
  </Style>
  <Style x:Key="SA.Type.Count" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Count.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Count.Weight}" />
  </Style>
  <Style x:Key="SA.Type.Label" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Base}">
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Label.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Label.Weight}" />
  </Style>

  <!-- Spacing 4, 8, 12, 16, 24 only. -->
  <sys:Double x:Key="SA.Space.XS">4</sys:Double>
  <sys:Double x:Key="SA.Space.S">8</sys:Double>
  <sys:Double x:Key="SA.Space.M">12</sys:Double>
  <sys:Double x:Key="SA.Space.L">16</sys:Double>
  <sys:Double x:Key="SA.Space.XL">24</sys:Double>

  <!-- Control sizes. -->
  <sys:Double x:Key="SA.Size.MainButton">34</sys:Double>
  <sys:Double x:Key="SA.Size.ButtonMin">28</sys:Double>
  <sys:Double x:Key="SA.Size.ButtonMax">32</sys:Double>
  <sys:Double x:Key="SA.Size.Row">32</sys:Double>
  <sys:Double x:Key="SA.Size.StepRow">40</sys:Double>
  <sys:Double x:Key="SA.Size.Input">30</sys:Double>
  <sys:Double x:Key="SA.Size.Pane">380</sys:Double>
  <sys:Double x:Key="SA.Size.SideBox">340</sys:Double>
  <sys:Double x:Key="SA.Size.StepMark">26</sys:Double>
  <sys:Double x:Key="SA.Size.SelectedMark">3</sys:Double>
  <CornerRadius x:Key="SA.Radius.Control">3</CornerRadius>
  <CornerRadius x:Key="SA.Radius.Chip">12</CornerRadius>

  <!-- R372, the pane of 7.2. Its gaps are the spacing of the spec, a line is 1, the outline of a step mark 2, the label column
       and the mark column are Code's choice, listed in steps/ui-shots/README.md. -->
  <Thickness x:Key="SA.Pad.Box">16,12,16,12</Thickness>
  <Thickness x:Key="SA.Pad.Section">16,16,16,0</Thickness>
  <Thickness x:Key="SA.Gap.Bottom16">0,0,0,16</Thickness>
  <Thickness x:Key="SA.Pad.Panel">12,8,12,8</Thickness>
  <Thickness x:Key="SA.Pad.Chip">8,4,8,4</Thickness>
  <Thickness x:Key="SA.Pad.Button">12,0,12,0</Thickness>
  <Thickness x:Key="SA.Gap.Top4">0,4,0,0</Thickness>
  <Thickness x:Key="SA.Gap.Top8">0,8,0,0</Thickness>
  <Thickness x:Key="SA.Gap.Top12">0,12,0,0</Thickness>
  <Thickness x:Key="SA.Gap.Row">0,4,0,4</Thickness>
  <Thickness x:Key="SA.Pad.Input">8,0,8,0</Thickness>
  <Thickness x:Key="SA.Gap.Right8">0,0,8,0</Thickness>
  <Thickness x:Key="SA.Gap.Left8">8,0,0,0</Thickness>
  <Thickness x:Key="SA.Gap.Left24">24,0,0,0</Thickness>
  <Thickness x:Key="SA.Line.Under">0,0,0,1</Thickness>
  <Thickness x:Key="SA.Line.All">1</Thickness>
  <sys:Double x:Key="SA.Size.RowMark">16</sys:Double>
  <sys:Double x:Key="SA.Size.MarkStroke">2</sys:Double>
  <sys:Double x:Key="SA.Size.Line">1</sys:Double>
  <sys:Double x:Key="SA.Size.RadioDot">8</sys:Double>
  <Geometry x:Key="SA.Mark.Down">M0 0l4 4l4-4</Geometry>
  <GridLength x:Key="SA.Grid.Mark">24</GridLength>
  <!-- The widest row label, Shared parameters at 116 in SA.Type.Body, and a gap of 8 -->
  <GridLength x:Key="SA.Grid.Label">124</GridLength>
  <GridLength x:Key="SA.Grid.StepMark">38</GridLength>
  <Geometry x:Key="SA.Mark.Found">M3 8.5l3.5 3.5l6.5-8</Geometry>
  <Geometry x:Key="SA.Mark.Missing">M2 8a6 6 0 1 0 12 0a6 6 0 1 0 -12 0z</Geometry>
  <Geometry x:Key="SA.Mark.MissingSign">M8 4.5v4.5M8 11.5v0.1</Geometry>

  <Style x:Key="SA.Pane.Section" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Section}">
    <Setter Property="Foreground" Value="{StaticResource SA.Heading}" />
  </Style>
  <Style x:Key="SA.Pane.Help" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Body}">
    <Setter Property="Foreground" Value="{StaticResource SA.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{StaticResource SA.Gap.Top4}" />
  </Style>
  <!-- A link in a line of text. When its command cannot run, with no document, it takes the text colour of the grey buttons and
       no underline, so it does not ask for a click it cannot take -->
  <Style x:Key="SA.Pane.Link" TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource SA.Accent}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource SA.Wait}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SA.Pane.Detail" TargetType="TextBlock" BasedOn="{StaticResource SA.Type.Small}">
    <Setter Property="Foreground" Value="{StaticResource SA.TextMuted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SA.Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource SA.Font}" />
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Body.Size}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Body.Weight}" />
    <Setter Property="Foreground" Value="{StaticResource SA.Text}" />
    <Setter Property="Background" Value="{StaticResource SA.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource SA.BorderStrong}" />
    <Setter Property="BorderThickness" Value="{StaticResource SA.Line.All}" />
    <Setter Property="Padding" Value="{StaticResource SA.Pad.Button}" />
    <Setter Property="Height" Value="{StaticResource SA.Size.ButtonMin}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource SA.Radius.Control}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource SA.WaitGround}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SA.Border}" />
              <Setter Property="Foreground" Value="{StaticResource SA.Wait}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SA.Button.Primary" TargetType="Button" BasedOn="{StaticResource SA.Button.Base}">
    <Setter Property="Foreground" Value="{StaticResource SA.Surface}" />
    <Setter Property="Background" Value="{StaticResource SA.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource SA.Accent}" />
    <Setter Property="FontWeight" Value="{StaticResource SA.Type.Label.Weight}" />
    <Setter Property="Height" Value="{StaticResource SA.Size.MainButton}" />
  </Style>
  <Style x:Key="SA.Pane.Choice" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource SA.Font}" />
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Body.Size}" />
    <Setter Property="Foreground" Value="{StaticResource SA.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="{StaticResource SA.Size.Row}" />
  </Style>
  <!-- The check box and the radio buttons drawn from the theme, radius 3 on the box, the ring and the box in SA.BorderStrong
       as the grey outline of QL7, a choice made in SA.Accent -->
  <Style x:Key="SA.Pane.Check" TargetType="CheckBox" BasedOn="{StaticResource SA.Pane.Choice}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="{StaticResource SA.Size.RowMark}" Height="{StaticResource SA.Size.RowMark}" VerticalAlignment="Center">
              <Border x:Name="Box" Background="{StaticResource SA.Surface}" BorderBrush="{StaticResource SA.BorderStrong}"
                      BorderThickness="{StaticResource SA.Line.All}" CornerRadius="{StaticResource SA.Radius.Control}" />
              <Path x:Name="Tick" Data="{StaticResource SA.Mark.Found}" Stroke="{StaticResource SA.Surface}" StrokeThickness="{StaticResource SA.Size.MarkStroke}"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Margin="{StaticResource SA.Gap.Left8}" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource SA.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SA.Accent}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource SA.WaitGround}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SA.Border}" />
              <Setter Property="Foreground" Value="{StaticResource SA.Wait}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SA.Pane.Radio" TargetType="RadioButton" BasedOn="{StaticResource SA.Pane.Choice}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="{StaticResource SA.Size.RowMark}" Height="{StaticResource SA.Size.RowMark}" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" Fill="{StaticResource SA.Surface}" Stroke="{StaticResource SA.BorderStrong}" StrokeThickness="{StaticResource SA.Size.Line}" />
              <Ellipse x:Name="Dot" Width="{StaticResource SA.Size.RadioDot}" Height="{StaticResource SA.Size.RadioDot}" Fill="{StaticResource SA.Accent}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Margin="{StaticResource SA.Gap.Left8}" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource SA.Accent}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Ring" Property="Fill" Value="{StaticResource SA.WaitGround}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource SA.Border}" />
              <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SA.Wait}" />
              <Setter Property="Foreground" Value="{StaticResource SA.Wait}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The inputs, 30 high, radius 3, border SA.Border -->
  <ControlTemplate x:Key="SA.Pane.ComboToggle" TargetType="ToggleButton">
    <Border x:Name="Box" Background="{StaticResource SA.Surface}" BorderBrush="{StaticResource SA.Border}"
            BorderThickness="{StaticResource SA.Line.All}" CornerRadius="{StaticResource SA.Radius.Control}">
      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource SA.Gap.Right8}" Data="{StaticResource SA.Mark.Down}"
            Stroke="{StaticResource SA.TextMuted}" StrokeThickness="{StaticResource SA.Size.Line}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Box" Property="Background" Value="{StaticResource SA.WaitGround}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="SA.Pane.Combo" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource SA.Font}" />
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Body.Size}" />
    <Setter Property="Foreground" Value="{StaticResource SA.Text}" />
    <Setter Property="Height" Value="{StaticResource SA.Size.Input}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Template="{StaticResource SA.Pane.ComboToggle}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter IsHitTestVisible="False" Margin="{StaticResource SA.Pad.Input}" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{StaticResource SA.Surface}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.All}"
                      CornerRadius="{StaticResource SA.Radius.Control}">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource SA.Wait}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SA.Pane.Entry" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource SA.Font}" />
    <Setter Property="FontSize" Value="{StaticResource SA.Type.Body.Size}" />
    <Setter Property="Foreground" Value="{StaticResource SA.Text}" />
    <Setter Property="Height" Value="{StaticResource SA.Size.Input}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Box" Background="{StaticResource SA.Surface}" BorderBrush="{StaticResource SA.Border}" BorderThickness="{StaticResource SA.Line.All}"
                  CornerRadius="{StaticResource SA.Radius.Control}" Padding="{StaticResource SA.Pad.Input}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SA.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource SA.WaitGround}" />
              <Setter Property="Foreground" Value="{StaticResource SA.Wait}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Icons on the 32 unit grid. Stroke SA.Heading, round caps and joins, fill none unless named. The 16 px set has stroke 2.4
       and drops the parts the spec marks 32 only, a part marked (16 px: ...) takes the path given there. A button with no
       number is keyed by its label with no spaces. White is SA.Surface (QL7). -->
  <sys:Double x:Key="SA.Icon.Stroke.32">2</sys:Double>
  <sys:Double x:Key="SA.Icon.Stroke.16">2.4</sys:Double>
  <sys:Double x:Key="SA.Icon.Tick.32">2.5</sys:Double>
  <sys:Double x:Key="SA.Icon.Tick.16">3</sys:Double>
  <sys:Double x:Key="SA.Icon.Wide">2.5</sys:Double>

  <Pen x:Key="SA.Icon.Pen.32" Brush="{StaticResource SA.Heading}" Thickness="{StaticResource SA.Icon.Stroke.32}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <Pen x:Key="SA.Icon.Pen.16" Brush="{StaticResource SA.Heading}" Thickness="{StaticResource SA.Icon.Stroke.16}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <Pen x:Key="SA.Icon.AccentPen.32" Brush="{StaticResource SA.IconAccent}" Thickness="{StaticResource SA.Icon.Stroke.32}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <Pen x:Key="SA.Icon.AccentPen.16" Brush="{StaticResource SA.IconAccent}" Thickness="{StaticResource SA.Icon.Stroke.16}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <Pen x:Key="SA.Icon.WhitePen.32" Brush="{StaticResource SA.Surface}" Thickness="{StaticResource SA.Icon.Stroke.32}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <Pen x:Key="SA.Icon.WhitePen.16" Brush="{StaticResource SA.Surface}" Thickness="{StaticResource SA.Icon.Stroke.16}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <Pen x:Key="SA.Icon.TickPen.32" Brush="{StaticResource SA.IconTick}" Thickness="{StaticResource SA.Icon.Tick.32}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <Pen x:Key="SA.Icon.TickPen.16" Brush="{StaticResource SA.IconTick}" Thickness="{StaticResource SA.Icon.Tick.16}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
  <Pen x:Key="SA.Icon.AccentPen.Wide" Brush="{StaticResource SA.IconAccent}" Thickness="{StaticResource SA.Icon.Wide}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />

  <!-- 1 Set up site -->
  <DrawingGroup x:Key="SA.Icon.1.32">
    <GeometryDrawing Pen="{StaticResource SA.Icon.Pen.32}" Geometry="M8 19a8 8 0 1 0 16 0a8 8 0 1 0 -16 0" />
    <GeometryDrawing Pen="{StaticResource SA.Icon.Pen.32}" Geometry="M16 14v10M11 19h10" />
    <GeometryDrawing Brush="{StaticResource SA.IconAccent}" Geometry="M16 2l4 7l-4-1.5l-4 1.5z" />
  </DrawingGroup>
  <DrawingGroup x:Key="SA.Icon.1.16">
    <GeometryDrawing Pen="{StaticResource SA.Icon.Pen.16}" Geometry="M8 19a8 8 0 1 0 16 0a8 8 0 1 0 -16 0" />
    <GeometryDrawing Pen="{StaticResource SA.Icon.Pen.16}" Geometry="M16 14v10M11 19h10" />
    <GeometryDrawing Brush="{StaticResource SA.IconAccent}" Geometry="M16 2l4 7l-4-1.5l-4 1.5z" />
  </DrawingGroup>

  <!-- 2 Read data -->
  <DrawingGroup x:Key="SA.Icon.2.32">
    <GeometryDrawing Pen="{StaticResource SA.Icon.Pen.32}" Geometry="M24 16V10l-6-6H7v24h9" />
    <GeometryDrawing Pen="{StaticResource SA.Icon.Pen.32}" Geometry="M18 4v6h6M11 15h8M11 19h4" />
    <GeometryDrawing Brush="{StaticResource SA.IconAccent}" Geometry="M17 24a6 6 0 1 0 12 0a6 6 0 1 0 -12 0" />
    <GeometryDrawing Pen="{StaticResource SA.Icon.WhitePen.32}" Geometry="M23 20.5v6M20.5 24.5l2.5 2.5l2.5-2.5" />
