<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Navis2D3D.Ui">

    <!-- The approved look (T58, Bader 11 Nov 2026), spec in notes\identity.md. Floating white panels on a warm ground, orange for
         the next step and for what is chosen: a chosen item is white with an orange edge and a soft glow, never a filled block.
         Cairo for all text, Fluent System Icons (MIT) as shapes. Key names are kept from before 062, so the code finds them. -->
    <SolidColorBrush x:Key="Accent" Color="#D2421C" />
    <!-- Orange text on a tinted background (#FAFAF9, #F1EFEC, EdgeSoft): Accent is only 4.0 to 4.4 to 1 there, this one is 5.2 to 5.9 to 1 (065). -->
    <SolidColorBrush x:Key="AccentDeep" Color="#B5381A" />
    <!-- Edge is for lines, marks and glow only. White on it is 3.5 to 1, so it is never a text colour or the ground of small white text (065). -->
    <SolidColorBrush x:Key="Edge" Color="#F0542D" />
    <SolidColorBrush x:Key="Glow" Color="#1AF0542D" />
    <SolidColorBrush x:Key="Ground" Color="#F1EFEC" />
    <SolidColorBrush x:Key="Inner" Color="#FAFAF9" />
    <!-- The dark of the align card and the badge that needs a look (named Navy before 066). -->
    <SolidColorBrush x:Key="Dark" Color="#1C1917" />
    <!-- A pale orange behind a hovered or chosen item (named CyanSoft before 066). -->
    <SolidColorBrush x:Key="EdgeSoft" Color="#FFF4F0" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#E7E5E4" />
    <SolidColorBrush x:Key="Text" Color="#292524" />
    <!-- Second text, dark enough to read at 12 px: there are no grey notes. -->
    <SolidColorBrush x:Key="Quiet" Color="#44403C" />
    <SolidColorBrush x:Key="Hover" Color="#F5F5F4" />
    <SolidColorBrush x:Key="Viewer" Color="#F7F6F4" />
    <SolidColorBrush x:Key="Amber" Color="#8A5A00" />
    <!-- The pale amber behind an amber chip: Changed in the BEP window, Out of date in Saved views (075). -->
    <SolidColorBrush x:Key="AmberSoft" Color="#FFF8EB" />
    <!-- The edge of a ticked row in Saved views (075). -->
    <SolidColorBrush x:Key="EdgeTicked" Color="#F3B7A5" />
    <SolidColorBrush x:Key="Red" Color="#B4232A" />
    <!-- The pale red behind a red chip: Plan gone in Saved views (T71, the board's Overdue colours). -->
    <SolidColorBrush x:Key="RedSoft" Color="#FDECEC" />
    <SolidColorBrush x:Key="Green" Color="#1E8E3E" />
    <SolidColorBrush x:Key="Ink" Color="#1C1917" />
    <!-- T66: the glow along the edge of the Parsons P at the top of the rail, the orange edge colour. -->
    <SolidColorBrush x:Key="LogoGlow" Color="#F0542D" />
    <!-- Cairo is bundled (SIL Open Font Licence), Latin and Arabic, 400 to 700. -->
    <FontFamily x:Key="Body">pack://application:,,,/Navis2D3D.Ui;component/Fonts/#Cairo</FontFamily>
    <FontFamily x:Key="Drawing">pack://application:,,,/Navis2D3D.Ui;component/Fonts/#Cairo</FontFamily>
    <!-- Three shadow levels (065). Lift1: panels and cards on the drawing. Lift2: menus and drop-down lists. Lift3: dialogs.
         Each goes on a separate empty border behind its panel, never on a panel that holds text, as an effect on a parent blurs the
         text and slows WPF. -->
    <DropShadowEffect x:Key="Lift1" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.14" Color="Black" />
    <DropShadowEffect x:Key="Lift2" BlurRadius="16" ShadowDepth="8" Direction="270" Opacity="0.18" Color="Black" />
    <DropShadowEffect x:Key="Lift3" BlurRadius="28" ShadowDepth="14" Direction="270" Opacity="0.24" Color="Black" />

    <!-- The keyboard focus ring, apart from the orange selection edge: a near black 2 px frame, 3 px outside the control (Margin -5 is
         the 3 px of air plus the 2 px line, as a rectangle keeps its stroke inside its own box). Never orange. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-5" Stroke="{StaticResource Ink}" StrokeThickness="2" RadiusX="12" RadiusY="12" SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

